# Optional environment variables for Astro-Exoplanets
# Copy to .env if you want to override defaults locally.

# Force offline fallback using backend/data/exoplanetas_nasa.csv (1 = enabled, 0 = disabled)
EXO_FORCE_OFFLINE=0

# Optional custom CA bundle for institutional TLS proxies (standard REQUESTS_CA_BUNDLE is also supported)
# ASTRO_CA_BUNDLE=/path/to/custom-ca.pem

# Optional custom directories (defaults resolve relative to package root)
# ASTRO_DATA_DIR=./data
# ASTRO_CACHE_DIR=./data/lightcurves_cache
